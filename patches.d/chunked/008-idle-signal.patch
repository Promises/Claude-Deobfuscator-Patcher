# patch: 008-idle-signal-chunked
# format: CHUNKED ONLY (2.1.242+). Monolithic keeps 008-idle-signal.patch.
# version: authored against 2.1.260
# depends: 002
# description: Emits {type:"idle"} when the REPL is at rest. The orchestrator
#              keys on this to know a seat is free.
#
# 🔴 REDUCED IN SCOPE ON PURPOSE — READ BEFORE RELYING ON IT.
#   The 2.1.238 patch installed its OWN useEffect with a 400 ms settle timer and
#   a three-part rest test: `_h !== 'waiting' && !mi && z.getMainThreadQueueLength() === 0`.
#   None of those three locals is addressable on a chunked tree: the REPL body is
#   React-Compiler output (`if (Vi[230] !== TDt || Vi[231] !== LDt)` …), where
#   every local is a minified name held in a numbered memo-cache slot and adding
#   a hook that reads three of them would be exactly the silent-misbinding hazard
#   the patch rules forbid.
#
#   So this emits from INSIDE the existing session-activity effect instead, whose
#   callback already receives the REPL's own computed status:
#       l$e({ status: uie, waitingFor: ZHe }, JHe)
#   and fires when `uie === 'idle'` with no `waitingFor`. That is upstream's own
#   idea of idle, not a reconstruction of it.
#
#   DIFFERENCES FROM THE MONOLITHIC BEHAVIOUR, stated rather than glossed:
#     - NO 400 ms debounce. The signal fires on the status transition, so a
#       consumer that expects the settle delay may see it marginally earlier.
#     - The message-queue depth is NOT consulted. If upstream reports 'idle'
#       while a queued prompt is pending, this would emit where the old one
#       would not.
#   Both are behaviour changes in the emit CONDITION, not in the message shape;
#   {type:"idle"} is unchanged, so the orchestrator contract holds.
#
# ANCHOR: `l$e` and `uie` are minified and appear as CONTEXT (the added lines
#   reference `uie`/`ZHe`, which the context line directly above binds and gives
#   meaning to via the literal property names `status:` and `waitingFor:` —
#   those property names are the real anchor and cannot be minified).
#   `uie === 'idle'` compares against a STRING LITERAL.
#
# ⚠️ NOT EXERCISED BY THE HEADLESS TURN TEST (no REPL). Applying and bundling are
#   VERIFIED; live idle emission is BELIEVED.
diff --git a/components/PromptInput/useSwarmBanner.js b/components/PromptInput/useSwarmBanner.js
index dc1d67d..eeeb1d9 100644
--- a/components/PromptInput/useSwarmBanner.js
+++ b/components/PromptInput/useSwarmBanner.js
@@ -68651,12 +68651,16 @@ function die(TFr) {
     else ((qRo = $C[31]), (GRo = $C[32]));
     E(qRo, GRo);
     let KRo, zRo;
     if ($C[33] !== uie || $C[34] !== JHe || $C[35] !== ZHe)
         ((KRo = () => {
             l$e({ status: uie, waitingFor: ZHe }, JHe).catch(aPo);
+            try {
+                if (uie === 'idle' && !ZHe)
+                    globalThis.__claudiverse.mirrorMessage({ type: 'idle' });
+            } catch (__e) {}
         }),
             (zRo = [uie, ZHe, JHe]),
             ($C[33] = uie),
             ($C[34] = JHe),
             ($C[35] = ZHe),
