+    // patches.d/chunked-2.1.280/PORTING-GUIDE.md
+    // These three patches could not be re-anchored for 2.1.280 and are ABSENT
+    // from this binary. Recorded loudly rather than left silent: a missing hook
+    // is invisible from the outside — the binary compiles, runs, and reports
+    // the right version while the feature simply never fires, which is the
+    // exact failure this project has been bitten by before.
+    globalThis.__claudiverseUnwired = [
+        '005-command-hooks',
+        '010-cvstate-heartbeat',
+        '012-account-failover',
+    ];
     var WebSocket, http, https, fs;
